# Wayback / Internet Archive
WAYBACK_DOMAIN=projecthindukush.com
WAYBACK_PATH_PREFIX=/incident/
WAYBACK_DELAY=2
WAYBACK_TIMEOUT=60
WAYBACK_MAX_RETRIES=5
WAYBACK_USER_AGENT=PKH-Restorer/0.1 (projecthindukush local restoration; respectful of archive.org rate limits)

# WordPress site (XAMPP)
WP_URL=http://localhost/projecthindukush
WP_PATH=C:\xampp1\htdocs\projecthindukush
PHP_BINARY=C:\xampp1\php\php.exe
MYSQL_BINARY=C:\xampp1\mysql\bin\mysql.exe
WP_USERNAME=admin
WP_PASSWORD=change-me
WP_ADMIN_EMAIL=admin@localhost.test
WP_SITE_TITLE=PROJECT HINDUKUSH

# WordPress database
WP_DB_NAME=projecthindukush
WP_DB_USER=root
WP_DB_PASSWORD=
WP_DB_HOST=localhost

# Restore controls
RESTORE_LIMIT=50

# Optional AI fallback (only used when deterministic extraction fails)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
AI_EXTRACTION_ENABLED=false
